---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
---

<BaseLayout title="About — Creative Gallery">
  <Navbar />

  <section class="about-section">
    <div class="about-container-new">
      <div class="about-video-main">
        <video src="/videos/Portfolio_v2.mp4" autoplay muted loop playsinline controls class="showreel-video"></video>
      </div>
      
      <div class="about-info">
        <h1 class="about-title-minimal">Justine Javines Showreel</h1>
        <div class="about-meta">
          <span class="meta-item">Creative Director</span>
          <span class="meta-divider">•</span>
          <span class="meta-item">2025</span>
        </div>
        <p class="about-description">
          A showcase of creative work and artistic vision, highlighting projects and expertise in visual storytelling and design.
        </p>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="footer-links">
      <a href="/about" class="footer-link">About</a>
      <a href="/developer" class="footer-link">Developer</a>
      <a href="/copyright" class="footer-link">Copyright Law</a>
      <a href="/faqs" class="footer-link">FAQs</a>
    </div>
    <div class="footer-copyright">
      All rights reserved Kienth Justine Javines 2025
    </div>
  </footer>
</BaseLayout>

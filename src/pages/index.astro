---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import MediaCard from '../components/MediaCard.astro';

const carouselRows = [
  {
    id: 'row-1',
    title: 'After Effects Edit',
    items: [
      { videoSrc: '/videos/1.mp4', title: 'Villian', uploadDate: 'Dec 28, 2024', genre: 'Movie AMV' },
      { videoSrc: '/videos/2.mp4', title: 'M3 MoGraph', uploadDate: 'Dec 30, 2024', genre: 'Car Edit' },
      { videoSrc: '/videos/3.mp4', title: 'Cinematic', uploadDate: 'Jan 2, 2025', genre: 'Documentary' },
      { videoSrc: '/videos/4.mp4', title: 'Abstract Visuals', uploadDate: 'Jan 3, 2025', genre: 'Experimental' },
      { videoSrc: '/videos/5.mp4', title: 'Abstract Visuals', uploadDate: 'Jan 4, 2025', genre: 'Experimental' }
    ]
  },
  {
    id: 'row-2',
    title: 'After Effects Edit 2',
    items: [
      { videoSrc: '/videos/6.mp4', title: 'Night City', uploadDate: 'Dec 25, 2024', genre: 'Cinematography' },
      { videoSrc: '/videos/7.mp4', title: 'Dance Performance', uploadDate: 'Dec 27, 2024', genre: 'Performance' },
      { videoSrc: '/videos/8.mp4', title: 'Tech Review', uploadDate: 'Dec 29, 2024', genre: 'Review' },
      { videoSrc: '/videos/9.mp4', title: 'Nature Walk', uploadDate: 'Jan 1, 2025', genre: 'Documentary' },
      { videoSrc: '/videos/10.mp4', title: 'Music Video', uploadDate: 'Jan 2, 2025', genre: 'Music' }
    ]
  },
  {
    id: 'row-3',
    title: 'After Effects Edit 3',
    items: [
      { videoSrc: '/videos/11.mp4', title: 'Fashion Film', uploadDate: 'Dec 20, 2024', genre: 'Fashion' },
      { videoSrc: '/videos/12.mp4', title: 'Food Journey', uploadDate: 'Dec 22, 2024', genre: 'Food' },
      { videoSrc: '/videos/13.mp4', title: 'Travel Vlog', uploadDate: 'Dec 24, 2024', genre: 'Travel' },
      { videoSrc: '/videos/14.mp4', title: 'Art Process', uploadDate: 'Dec 26, 2024', genre: 'Art' },
      { videoSrc: '/videos/15.mp4', title: 'Behind The Scenes', uploadDate: 'Dec 28, 2024', genre: 'BTS' }
    ]
  },
  {
    id: 'row-4',
    title: 'Premiere Edit',
    items: [
      { videoSrc: '/videos/16.mp4', title: 'Sports Highlight', uploadDate: 'Dec 15, 2024', genre: 'Sports' },
      { videoSrc: '/videos/17.mp4', title: 'Architecture Tour', uploadDate: 'Dec 18, 2024', genre: 'Architecture' },
      { videoSrc: '/videos/18.mp4', title: 'Interview Series', uploadDate: 'Dec 21, 2024', genre: 'Interview' },
      { videoSrc: '/videos/19.mp4', title: 'Time Lapse', uploadDate: 'Dec 23, 2024', genre: 'Time Lapse' },
      { videoSrc: '/videos/20.mp4', title: 'Event Coverage', uploadDate: 'Dec 25, 2024', genre: 'Event' }
    ]
  },
  {
    id: 'row-5',
    title: 'Premiere Edit',
    items: [
      { videoSrc: '/videos/21.mp4', title: 'Tutorial Series', uploadDate: 'Jan 4, 2025', genre: 'Tutorial' },
      { videoSrc: '/videos/22.mp4', title: 'Lifestyle Vlog', uploadDate: 'Jan 5, 2025', genre: 'Lifestyle' },
      { videoSrc: '/videos/23.mp4', title: 'Creative Process', uploadDate: 'Jan 5, 2025', genre: 'Creative' }
    ]
  }
];

const categories = ['Short Films', 'Long Forms', 'Short Forms', 'Photo', 'Cinematography'];
---

<BaseLayout title="Creative Gallery — Astro">
  <Navbar />

  <section class="hero-section">
    <div class="wave-background"></div>
    
    <div class="hero-content">
      <img src="/hero-title.svg" alt="CREATE" class="hero-title-img" />
      <div class="hero-subtitle">Upload now and Vote!</div>
      
      <div class="hero-buttons">
        <a href="#carousel-section" class="btn">See Creatives</a>
        <a href="/about" class="btn">Learn More</a>
      </div>
      
      <p class="hero-description">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt 
        ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation 
        ullamco laboris nisi ut aliquip ex ea commodo consequat.
      </p>

      <div class="category-pills">
        {categories.map(cat => <span class="pill">{cat}</span>)}
      </div>
    </div>
  </section>

  <section class="multi-carousel-section" id="carousel-section">
    {carouselRows.map((row) => (
      <div class="carousel-row" data-row-id={row.id}>
        <h2 class="carousel-row-title">{row.title}</h2>
        
        <div class="carousel-row-container">
          <button class="carousel-nav-btn carousel-nav-prev" data-direction="prev" aria-label="Previous">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>

          <div class="carousel-track-wrapper">
            <div class="carousel-track">
              {row.items.map((item, index) => (
                <div class="carousel-card" data-index={index}>
                  <MediaCard videoSrc={item.videoSrc} title={item.title} uploadDate={item.uploadDate} genre={item.genre} />
                </div>
              ))}
            </div>
          </div>

          <button class="carousel-nav-btn carousel-nav-next" data-direction="next" aria-label="Next">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        </div>

        <div class="carousel-pagination"></div>
      </div>
    ))}
  </section>

  <footer class="site-footer">
    <div class="footer-links">
      <a href="/about" class="footer-link">About</a>
      <a href="/developer" class="footer-link">Developer</a>
      <a href="/copyright" class="footer-link">Copyright Law</a>
      <a href="/faqs" class="footer-link">FAQs</a>
    </div>
    <div class="footer-copyright">
      All rights reserved Kienth Justine Javines 2025
    </div>
  </footer>
</BaseLayout>

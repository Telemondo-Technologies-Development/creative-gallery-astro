---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import MediaCard from '../components/MediaCard.astro';

const carouselRows = [
  {
    id: 'row-1',
    title: 'Trending Projects',
    items: [
      { title: 'Creative Video Title', type: 'Video', icon: '▶' },
      { title: 'Creative Image Title', type: 'Image', icon: '🖼' },
      { title: 'Documentary Short', type: 'Video', icon: '▶' },
      { title: 'Abstract Design', type: 'Image', icon: '🖼' },
      { title: 'Motion Graphics', type: 'Video', icon: '▶' },
      { title: 'Brand Identity', type: 'Image', icon: '🖼' },
      { title: 'Film Reel', type: 'Video', icon: '▶' },
      { title: 'Photography Series', type: 'Image', icon: '🖼' }
    ]
  },
  {
    id: 'row-2',
    title: 'Featured Creatives',
    items: [
      { title: 'Another Video Project', type: 'Video', icon: '▶' },
      { title: 'Photography Work', type: 'Image', icon: '🖼' },
      { title: 'Urban Landscapes', type: 'Image', icon: '🖼' },
      { title: 'Digital Illustration', type: 'Image', icon: '🖼' },
      { title: 'Short Film', type: 'Video', icon: '▶' },
      { title: 'Product Design', type: 'Image', icon: '🖼' },
      { title: 'Animation Loop', type: 'Video', icon: '▶' },
      { title: 'Editorial Design', type: 'Image', icon: '🖼' }
    ]
  },
  {
    id: 'row-3',
    title: 'Popular This Week',
    items: [
      { title: 'Short Film Showcase', type: 'Video', icon: '▶' },
      { title: 'Digital Art Piece', type: 'Image', icon: '🖼' },
      { title: 'Cinematic Reel', type: 'Video', icon: '▶' },
      { title: 'UI/UX Design', type: 'Image', icon: '🖼' },
      { title: 'Music Video', type: 'Video', icon: '▶' },
      { title: 'Typography Work', type: 'Image', icon: '🖼' },
      { title: 'Commercial Spot', type: 'Video', icon: '▶' },
      { title: 'Packaging Design', type: 'Image', icon: '🖼' }
    ]
  },
  {
    id: 'row-4',
    title: 'Recommended For You',
    items: [
      { title: 'Portrait Series', type: 'Image', icon: '🖼' },
      { title: 'Animation Project', type: 'Video', icon: '▶' },
      { title: 'Abstract Art', type: 'Image', icon: '🖼' },
      { title: 'Documentary', type: 'Video', icon: '▶' },
      { title: 'Fashion Photography', type: 'Image', icon: '🖼' },
      { title: '3D Rendering', type: 'Image', icon: '🖼' },
      { title: 'Explainer Video', type: 'Video', icon: '▶' },
      { title: 'Logo Design', type: 'Image', icon: '🖼' }
    ]
  },
  {
    id: 'row-5',
    title: 'Latest Uploads',
    items: [
      { title: 'Music Video', type: 'Video', icon: '▶' },
      { title: 'Nature Photography', type: 'Image', icon: '🖼' },
      { title: 'Behind the Scenes', type: 'Video', icon: '▶' },
      { title: 'Poster Design', type: 'Image', icon: '🖼' },
      { title: 'Time Lapse', type: 'Video', icon: '▶' },
      { title: 'Architecture Photo', type: 'Image', icon: '🖼' },
      { title: 'Promo Video', type: 'Video', icon: '▶' },
      { title: 'Web Design', type: 'Image', icon: '🖼' }
    ]
  }
];

const categories = ['Short Films', 'Long Forms', 'Short Forms', 'Photo', 'Cinematography'];
---

<BaseLayout title="Creative Gallery — Astro">
  <Navbar />

  <section class="hero-section">
    <div class="wave-background"></div>
    
    <div class="hero-content">
      <img src="/hero-title.svg" alt="CREATE" class="hero-title-img" />
      <div class="hero-subtitle">Upload now and Vote!</div>
      
      <div class="hero-buttons">
        <a href="#carousel-section" class="btn">See Creatives</a>
        <a href="/about" class="btn">Learn More</a>
      </div>
      
      <p class="hero-description">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt 
        ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation 
        ullamco laboris nisi ut aliquip ex ea commodo consequat.
      </p>

      <div class="category-pills">
        {categories.map(cat => <span class="pill">{cat}</span>)}
      </div>
    </div>
  </section>

  <section class="multi-carousel-section" id="carousel-section">
    {carouselRows.map((row) => (
      <div class="carousel-row" data-row-id={row.id}>
        <h2 class="carousel-row-title">{row.title}</h2>
        
        <div class="carousel-row-container">
          <button class="carousel-nav-btn carousel-nav-prev" data-direction="prev" aria-label="Previous">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>

          <div class="carousel-track-wrapper">
            <div class="carousel-track">
              {row.items.map((item, index) => (
                <div class="carousel-card" data-index={index}>
                  <MediaCard title={item.title} type={item.type} icon={item.icon} />
                </div>
              ))}
            </div>
          </div>

          <button class="carousel-nav-btn carousel-nav-next" data-direction="next" aria-label="Next">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        </div>

        <div class="carousel-pagination"></div>
      </div>
    ))}

    <div class="upload-section">
      <h3 class="upload-title">Upload Your Creative Work</h3>
      <p class="upload-description">
        Share your creative projects with the community. Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
      </p>
      <div class="upload-container">
        <div class="upload-area" id="uploadArea">
          <div class="upload-icon">📤</div>
          <div class="upload-text">Drag & Drop your images here</div>
          <div class="upload-subtext">or click to browse (JPG, PNG, GIF, WebP)</div>
          <input type="file" id="fileInput" accept="image/*" multiple />
        </div>
        <div class="upload-preview" id="uploadPreview"></div>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="footer-links">
      <a href="/about" class="footer-link">About</a>
      <a href="/developer" class="footer-link">Developer</a>
      <a href="/copyright" class="footer-link">Copyright Law</a>
      <a href="/faqs" class="footer-link">FAQs</a>
    </div>
    <div class="footer-copyright">
      All rights reserved Kienth Justine Javines 2025
    </div>
  </footer>
</BaseLayout>

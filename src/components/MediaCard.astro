---
const { videoSrc, title, uploadDate, genre } = Astro.props;
---

<div class="media-card" data-title={title} data-upload-date={uploadDate} data-genre={genre}>
  <div class="media-placeholder">
    {videoSrc ? (
      <video src={videoSrc} muted loop playsinline preload="metadata"></video>
    ) : (
      <span class="placeholder-icon">▶</span>
    )}
  </div>
  <div class="media-info">
    <h3 class="media-title">video</h3>
  </div>
</div>
